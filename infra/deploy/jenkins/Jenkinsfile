// Replica los mismos stages que .github/workflows/*.yml, para demostrar conocimiento de sintaxis
// Jenkins/enterprise — NO se ejecuta en este repo (no hay infraestructura Jenkins disponible),
// ver la tabla "qué es real vs documentado" del README.
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    stages {
        stage('Restaurar y compilar backend') {
            steps {
                sh 'dotnet restore services/VenuePulse.slnx'
                sh 'dotnet build services/VenuePulse.slnx --no-restore -c Release'
            }
        }

        stage('Tests backend (unit + arquitectura + integración)') {
            steps {
                sh 'dotnet test services/VenuePulse.slnx --no-build -c Release --logger "trx" --results-directory TestResults'
            }
            post {
                always {
                    junit 'TestResults/*.trx'
                }
            }
        }

        stage('Build y test frontend') {
            matrix {
                axes {
                    axis {
                        name: 'APP'
                        values 'shell', 'ticket-checkout', 'venue-ops'
                    }
                }
                stages {
                    stage('npm ci + lint + build') {
                        steps {
                            dir("ui/${APP}") {
                                sh 'npm ci'
                                sh 'npm run lint'
                                sh 'npm run build'
                            }
                        }
                    }
                }
            }
        }

        stage('Build de imágenes Docker') {
            steps {
                sh 'docker build -f services/Ticketing/Api/Dockerfile -t venuepulse-api-ticketing:${BUILD_NUMBER} .'
                sh 'docker build -f services/AccessControl/Api/Dockerfile -t venuepulse-api-accesscontrol:${BUILD_NUMBER} .'
                sh 'docker build -f services/CheckIn/Api/Dockerfile -t venuepulse-api-checkin:${BUILD_NUMBER} .'
            }
        }

        stage('Guard: sin ficheros de desarrollo local en la imagen') {
            steps {
                sh '''
                    for image in api-ticketing api-accesscontrol api-checkin; do
                        docker save venuepulse-${image}:${BUILD_NUMBER} | tar -tv | grep -i "\\.ia" && exit 1 || true
                    done
                '''
            }
        }
    }
}
